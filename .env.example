# Environment variables — copy to .env for local development
# For production, set these in your Vercel project dashboard (never commit secrets)

# ── Database ──────────────────────────────────────────────────────────────────
# Local development: SQLite
DATABASE_URL="file:./dev.db"

# Production: Use Vercel Postgres, Neon, or Supabase (postgresql://)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a random 32-char secret: openssl rand -hex 32
NEXTAUTH_SECRET="replace-me-with-a-32-char-random-string"

# Full URL of your site (http://localhost:3000 for dev, https://yoursite.vercel.app in prod)
NEXTAUTH_URL="http://localhost:3000"

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-password-here"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_NUMBER="9779843046108"
