# Environment variables — copy to .env for local development
# For production, set these in your Vercel project dashboard (never commit secrets)

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: Direct connection URL for Prisma migrations (if using connection pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a random 32-char secret: openssl rand -hex 32
NEXTAUTH_SECRET="replace-me-with-a-32-char-random-string"

# Full URL of your site (http://localhost:3000 for dev, https://yoursite.vercel.app in prod)
NEXTAUTH_URL="http://localhost:3000"

# ── Admin credentials ─────────────────────────────────────────────────────────
# Admin email for login
ADMIN_EMAIL="admin@example.com"

# Admin password hash (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
ADMIN_PASSWORD_HASH="$2a$10$placeholder.hash.replace.with.real.bcrypt.hash"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_NUMBER="9779863912884"
